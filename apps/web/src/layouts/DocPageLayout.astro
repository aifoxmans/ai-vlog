---
import type { NavigationItem, SiteSettings } from "@ai-vlog/shared";
import DocFooter from "../components/DocFooter.astro";
import DocTopNav from "../components/DocTopNav.astro";

interface Props {
  title: string;
  description: string;
  settings: SiteSettings;
  navigation: NavigationItem[];
  path?: string;
  mainClass?: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: unknown[];
}

const {
  title,
  description,
  settings,
  navigation,
  path = Astro.url.pathname,
  mainClass = "max-w-[1200px] mx-auto px-6",
  image,
  noindex = false,
  jsonLd = []
} = Astro.props;

const canonical = new URL(path, settings.siteUrl).toString();
const ogImage = image || `${settings.siteUrl}/og-default.png`;
---

<!doctype html>
<html class="light" lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,nofollow" : "index,follow"} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd.map((entry) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(entry)} />
    ))}
    <script is:inline src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
    />
    <script is:inline>
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              "on-primary-container": "#005b78",
              "inverse-primary": "#7bd1fa",
              "surface-container-low": "#f1f3ff",
              "tertiary-fixed-dim": "#dcb8ff",
              "surface-container": "#e9edff",
              "surface-tint": "#006686",
              "secondary-container": "#bae6ff",
              "on-secondary-fixed": "#001e2b",
              "on-tertiary-fixed-variant": "#59367d",
              outline: "#6f787e",
              secondary: "#376479",
              "on-tertiary": "#ffffff",
              "secondary-fixed": "#c0e8ff",
              "surface-variant": "#d8e2fd",
              "surface-bright": "#f9f9ff",
              "on-surface": "#111b2f",
              "primary-fixed": "#c0e8ff",
              "on-error-container": "#93000a",
              "outline-variant": "#bec8ce",
              background: "#f9f9ff",
              "surface-container-lowest": "#ffffff",
              "on-secondary-container": "#3c687e",
              error: "#ba1a1a",
              "on-secondary-fixed-variant": "#1c4c60",
              "on-primary-fixed-variant": "#004d66",
              "on-primary-fixed": "#001e2b",
              tertiary: "#724e97",
              "on-secondary": "#ffffff",
              "on-error": "#ffffff",
              "inverse-on-surface": "#edf0ff",
              "surface-container-highest": "#d8e2fd",
              "on-surface-variant": "#3f484e",
              "surface-container-high": "#e0e8ff",
              "tertiary-fixed": "#f0dbff",
              "on-tertiary-fixed": "#2b024f",
              "primary-fixed-dim": "#7bd1fa",
              "inverse-surface": "#263045",
              "primary-container": "#7dd3fc",
              "tertiary-container": "#ddbaff",
              "error-container": "#ffdad6",
              "surface-dim": "#d0daf5",
              surface: "#f9f9ff",
              "secondary-fixed-dim": "#a0cde5",
              primary: "#006686",
              "on-tertiary-container": "#66438b",
              "on-primary": "#ffffff",
              "on-background": "#111b2f"
            },
            borderRadius: {
              DEFAULT: "0.25rem",
              lg: "0.5rem",
              xl: "0.75rem",
              full: "9999px"
            },
            spacing: {
              "section-padding": "80px",
              gutter: "16px",
              unit: "8px",
              "margin-mobile": "16px",
              "container-max": "1200px",
              "margin-desktop": "48px",
              md: "16px",
              base: "8px",
              margin: "24px",
              xs: "4px",
              sm: "8px",
              xl: "32px",
              lg: "24px"
            },
            fontFamily: {
              h2: ["Inter"],
              "body-md": ["Inter"],
              "body-lg": ["Inter"],
              h1: ["Inter"],
              h3: ["Inter"],
              "label-caps": ["Inter"],
              "headline-md": ["Inter"],
              "headline-lg": ["Inter"],
              "label-sm": ["Inter"],
              inter: ["Inter"]
            },
            fontSize: {
              h2: ["32px", { lineHeight: "1.25", letterSpacing: "-0.01em", fontWeight: "700" }],
              "body-md": ["16px", { lineHeight: "1.6", letterSpacing: "0", fontWeight: "400" }],
              "body-lg": ["16px", { lineHeight: "1.6", fontWeight: "400" }],
              h1: ["40px", { lineHeight: "1.2", letterSpacing: "-0.02em", fontWeight: "700" }],
              h3: ["24px", { lineHeight: "1.3", letterSpacing: "0", fontWeight: "600" }],
              "label-caps": ["12px", { lineHeight: "1.0", letterSpacing: "0.05em", fontWeight: "600" }],
              "headline-md": ["24px", { lineHeight: "1.3", fontWeight: "600" }],
              "headline-lg": ["32px", { lineHeight: "1.2", letterSpacing: "-0.02em", fontWeight: "700" }],
              "label-sm": ["12px", { lineHeight: "1.0", letterSpacing: "0.05em", fontWeight: "500" }]
            }
          }
        }
      };
    </script>
    <style is:global>
      .material-symbols-outlined {
        font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 24;
        vertical-align: middle;
      }

      body {
        background-color: #f9f9ff;
        color: #111b2f;
      }

      .glass-card {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(12px);
        border: 1px solid #e5e5ea;
      }

      .hero-gradient {
        background: radial-gradient(circle at 50% 0%, #d8e2ff 0%, #f9f9ff 100%);
      }

      .bento-grid {
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: 24px;
      }

      .bento-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .bento-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 30px rgba(0, 58, 188, 0.08);
      }

      .timeline-border {
        position: relative;
      }

      .timeline-border::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 2px;
        background: #e5e5ea;
      }

      .doc-prose {
        display: grid;
        gap: 1.2rem;
        color: #3f484e;
        line-height: 1.8;
      }

      .doc-prose > * {
        margin: 0;
      }

      .doc-prose p,
      .doc-prose li {
        color: #3f484e;
        font-size: 1rem;
      }

      .doc-prose h2,
      .doc-prose h3,
      .doc-prose h4 {
        color: #111b2f;
        line-height: 1.12;
        letter-spacing: -0.03em;
      }

      .doc-prose h2 {
        margin-top: 2rem;
        font-size: clamp(1.8rem, 3vw, 2.4rem);
      }

      .doc-prose h3 {
        margin-top: 1.5rem;
        font-size: clamp(1.35rem, 2.2vw, 1.8rem);
      }

      .doc-prose ul,
      .doc-prose ol {
        margin: 0;
        padding-left: 1.25rem;
      }

      .doc-prose li + li {
        margin-top: 0.5rem;
      }

      .doc-prose blockquote {
        margin: 0;
        border-left: 4px solid #006686;
        border-radius: 18px;
        background: #f1f3ff;
        padding: 1rem 1.25rem;
        color: #263045;
      }

      .doc-prose code {
        border-radius: 8px;
        background: #e9edff;
        padding: 0.12rem 0.35rem;
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.92em;
      }

      .doc-prose pre {
        overflow-x: auto;
        border-radius: 22px;
        background: #111b2f;
        padding: 1rem 1.2rem;
      }

      .doc-prose pre code {
        background: transparent;
        padding: 0;
        color: #edf0ff;
      }

      .doc-prose a {
        color: #006686;
        text-decoration: underline;
        text-underline-offset: 0.18em;
      }

      .doc-prose hr {
        border: 0;
        border-top: 1px solid #d8e2fd;
      }
    </style>
  </head>
  <body class="bg-background font-body-md text-on-background antialiased">
    <DocTopNav navigation={navigation} currentPath={Astro.url.pathname} settings={settings} />
    <main class={mainClass}>
      <slot />
    </main>
    <DocFooter settings={settings} />
  </body>
</html>
