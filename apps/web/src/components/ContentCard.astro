---
import { sectionMeta } from "@ai-vlog/shared";
import type { ContentItem } from "@ai-vlog/shared";
import { formatDate, formatNumber } from "../lib/format";

interface Props {
  item: ContentItem;
  compact?: boolean;
}

const { item, compact = false } = Astro.props;
const section = item.section === "page" ? "learn" : item.section;
const meta = sectionMeta[section];
---

<article class:list={["content-card", compact && "content-card-compact"]}>
  {item.coverImage && (
    <a href={`/posts/${item.slug}`} class="content-card-cover">
      <img src={item.coverImage} alt={item.coverAlt || item.title} loading="lazy" />
    </a>
  )}
  <div class="content-card-body">
    <div class="eyebrow-row">
      <span>{meta.label}</span>
      <span>{formatDate(item.publishedAt || item.updatedAt)}</span>
    </div>
    <h3><a href={`/posts/${item.slug}`}>{item.title}</a></h3>
    <p>{item.excerpt}</p>
    <div class="card-meta">
      <div class="chip-row">
        {item.category && <a href={`/categories/${item.category.slug}`}>#{item.category.name}</a>}
        {item.tags.slice(0, 3).map((tag) => (
          <a href={`/tags/${tag.slug}`}>#{tag.name}</a>
        ))}
      </div>
      <div class="metric-row">
        {typeof item.readingTime === "number" && <span>{item.readingTime} min</span>}
        {item.metrics?.views && <span>{formatNumber(item.metrics.views)} 浏览</span>}
      </div>
    </div>
  </div>
</article>

