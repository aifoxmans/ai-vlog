---
import type { SiteSettings } from "@ai-vlog/shared";

interface Props {
  settings: SiteSettings;
}

const { settings } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="w-full border-t border-gray-100 bg-white py-16">
  <div class="mx-auto flex max-w-[1200px] flex-col items-center justify-between gap-8 px-6 text-sm md:flex-row">
    <div class="flex flex-col items-center gap-3 md:items-start">
      <div class="text-lg font-bold text-gray-900">{settings.siteName}</div>
      <p class="max-w-md text-center text-gray-400 md:text-left">
        © {year} {settings.siteName}. {settings.siteDescription}
      </p>
    </div>
    <nav class="flex flex-wrap items-center justify-center gap-8">
      {settings.socialLinks.map((link) => (
        <a class="text-gray-400 transition-colors hover:text-gray-900" href={link.href}>
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</footer>
