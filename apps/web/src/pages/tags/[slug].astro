---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentCard from "../../components/ContentCard.astro";
import SectionHero from "../../components/SectionHero.astro";
import { getNavigationData, getTagItems } from "../../lib/api";

const { slug } = Astro.params;
const [{ navigation, settings }, data] = await Promise.all([
  getNavigationData(),
  getTagItems(slug || "")
]);
---

<BaseLayout
  title={`标签 #${slug} | ${settings.siteName}`}
  description={`查看与 ${slug} 相关的内容聚合页面。`}
  settings={settings}
  navigation={navigation}
  path={`/tags/${slug}`}
>
  <SectionHero
    kicker="Tag"
    title={`#${slug}`}
    summary="标签页承担主题聚合和内部链接承接的角色，用于提升站点的语义连续性。"
  />
  <section class="site-shell">
    <div class="card-grid">
      {data.items.map((item) => (
        <ContentCard item={item} />
      ))}
    </div>
  </section>
</BaseLayout>

