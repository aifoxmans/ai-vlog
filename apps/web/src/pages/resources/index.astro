---
import DocPageLayout from "../../layouts/DocPageLayout.astro";
import { getSectionPageData } from "../../lib/api";
import {
  itemHref,
  sectionVisuals
} from "../../lib/public-ui";

const { navigation, settings, meta, items, categories, tags } = await getSectionPageData("resources");
const lead = items[0];
---

<DocPageLayout
  title={`${meta.label} | ${settings.siteName}`}
  description={meta.summary}
  settings={settings}
  navigation={navigation}
  path={meta.href}
>
  <section class="hero-gradient relative mt-8 mb-20 overflow-hidden rounded-3xl border border-outline-variant/30 py-20 text-center">
    <div class="relative z-10 mx-auto max-w-2xl">
      <span class="mb-6 inline-block rounded-full bg-primary-fixed px-4 py-1.5 text-xs font-label-caps uppercase tracking-widest text-on-primary-fixed">
        Digital Arsenal
      </span>
      <h1 class="mb-6 font-h1 text-h1 text-on-surface">{meta.label}</h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant">{meta.summary}</p>
    </div>
    <div class="absolute right-0 top-0 -mr-20 -mt-20 opacity-10">
      <span class="material-symbols-outlined text-[300px]" style="font-variation-settings: 'FILL' 1">hub</span>
    </div>
  </section>

  <div class="mb-16 flex flex-wrap justify-center gap-4">
    <span class="flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-white shadow-lg shadow-primary/20">
      <span class="material-symbols-outlined">menu_book</span>
      <span class="font-semibold">全部资源</span>
    </span>
    {categories.map((category, index) => (
      <a
        href={`/categories/${category.slug}`}
        class="group flex items-center gap-2 rounded-full border border-outline-variant bg-white px-6 py-3 transition-colors hover:border-primary"
      >
        <span class="material-symbols-outlined text-outline transition-colors group-hover:text-primary">
          {index === 0 ? "school" : index === 1 ? "business_center" : "auto_fix_high"}
        </span>
        <span class="font-medium">{category.name}</span>
      </a>
    ))}
  </div>

  <section class="mb-24">
    <div class="mb-10 flex items-center justify-between">
      <div class="flex items-center gap-4">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-surface-container">
          <span class:list={["material-symbols-outlined", sectionVisuals.resources.accent]} style="font-variation-settings: 'FILL' 1">
            school
          </span>
        </div>
        <div>
          <h2 class="font-h2 text-h2">学习资源</h2>
          <p class="text-on-surface-variant">结构化沉淀高频使用的工具栈与方法库</p>
        </div>
      </div>
      {lead && (
        <a class="flex items-center gap-1 font-semibold text-primary hover:underline" href={itemHref(lead)}>
          查看更多 <span class="material-symbols-outlined text-sm">arrow_forward</span>
        </a>
      )}
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      {(items.slice(0, 3).length ? items.slice(0, 3) : items).map((item, index) => (
        <a
          href={itemHref(item)}
          class="bento-card flex flex-col rounded-2xl border border-outline-variant/30 bg-white p-8"
        >
          <div class="mb-6 flex items-start justify-between">
            <div class="flex h-14 w-14 items-center justify-center rounded-lg bg-surface-container-low">
              <span class="material-symbols-outlined text-3xl text-primary">
                {index === 0 ? "terminal" : index === 1 ? "menu_book" : "analytics"}
              </span>
            </div>
            <span class="rounded-full bg-surface-variant px-3 py-1 text-xs font-semibold text-on-surface-variant">
              {item.tags[0]?.name || "RESOURCE"}
            </span>
          </div>
          <h3 class="mb-3 font-h3 text-h3">{item.title}</h3>
          <p class="mb-6 text-sm text-on-surface-variant">{item.excerpt}</p>
          <div class="mt-auto border-t border-gray-100 pt-6">
            <div class="mb-2 flex items-center gap-2 text-primary">
              <span class="material-symbols-outlined text-sm">recommend</span>
              <span class="text-[10px] font-label-caps uppercase tracking-widest">推荐理由</span>
            </div>
            <p class="text-sm italic font-medium text-secondary">
              “{item.category?.description || meta.summary}”
            </p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="mb-24">
    <div class="mb-10 flex items-center justify-between">
      <div class="flex items-center gap-4">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-surface-container">
          <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1">
            business_center
          </span>
        </div>
        <div>
          <h2 class="font-h2 text-h2">商业工具</h2>
          <p class="text-on-surface-variant">支持内容发布、自动化协作与业务增长的实际工具</p>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-4">
      <div class="bento-card relative flex flex-col overflow-hidden rounded-3xl bg-primary-container p-10 text-white md:col-span-2">
        <div class="relative z-10">
          <div class="mb-8 flex h-16 w-16 items-center justify-center rounded-2xl bg-white/20 backdrop-blur-md">
            <span class="material-symbols-outlined text-4xl">automation</span>
          </div>
          <h3 class="mb-4 text-2xl font-bold">{lead?.title || "FlowMaster Pro"}</h3>
          <p class="mb-8 max-w-xs text-primary-fixed/80">
            {lead?.excerpt || "把站点发布、素材整理和内容分发串成低成本、可长期维护的自动化工作流。"}
          </p>
          <div class="border-t border-white/10 pt-8">
            <div class="mb-3 flex items-center gap-2">
              <span class="material-symbols-outlined text-sm">recommend</span>
              <span class="text-xs font-bold uppercase tracking-widest opacity-70">推荐理由</span>
            </div>
            <p class="text-sm font-medium leading-relaxed">
              “{lead?.category?.description || "最重要的不是功能数量，而是它是否降低了长期维护成本。"}”
            </p>
          </div>
        </div>
        <div class="absolute bottom-0 right-0 -mb-10 -mr-10 opacity-10">
          <span class="material-symbols-outlined text-[240px]" style="font-variation-settings: 'FILL' 1">
            settings_input_component
          </span>
        </div>
      </div>

      {tags.slice(0, 3).map((tag, index) => (
        <a
          href={`/tags/${tag.slug}`}
          class:list={[
            "bento-card flex flex-col rounded-2xl border border-outline-variant/30 bg-white p-6",
            index === 2 ? "md:col-span-2" : ""
          ]}
        >
          <span class="material-symbols-outlined mb-4 text-primary">
            {index === 0 ? "campaign" : index === 1 ? "cloud_sync" : "psychology"}
          </span>
          <h4 class="mb-2 font-bold">{tag.name}</h4>
          <p class="mb-6 text-xs text-on-surface-variant">
            围绕 #{tag.name} 整理工具与实践，方便在详情页、栏目页和后台中快速复用。
          </p>
          <div class="mt-auto border-t border-gray-50 pt-4">
            <span class="mb-1 block text-[10px] font-bold uppercase text-primary">推荐理由</span>
            <p class="text-[11px] italic leading-tight text-secondary">
              “作为高频主题入口，它能持续承担搜索流量和内部链接分发作用。”
            </p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="mb-24 rounded-[40px] border border-outline-variant/20 bg-surface-bright p-12 text-center">
    <h2 class="mb-4 font-h2 text-h2">{settings.newsletterTitle}</h2>
    <p class="mx-auto mb-10 max-w-lg text-on-surface-variant">{settings.newsletterSummary}</p>
    <div class="mx-auto flex max-w-md flex-col justify-center gap-4 md:flex-row">
      <input
        class="flex-grow rounded-xl bg-white px-6 py-4 outline-none ring-1 ring-outline-variant transition-all focus:ring-2 focus:ring-primary"
        placeholder="您的电子邮箱"
        type="email"
      />
      <button class="rounded-xl bg-primary px-8 py-4 font-bold text-on-primary shadow-lg shadow-primary/20 transition-transform active:scale-95">
        立即订阅
      </button>
    </div>
  </section>
</DocPageLayout>
