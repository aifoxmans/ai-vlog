---
import DocPageLayout from "../../layouts/DocPageLayout.astro";
import { getSectionPageData } from "../../lib/api";
import {
  formatDateDot,
  itemHref,
  itemImage,
  itemHighlights,
  sectionVisuals
} from "../../lib/public-ui";

const { navigation, settings, meta, items, categories, tags } = await getSectionPageData("learn");
const lead = items[0];
const secondary = items.slice(1, 3);
const tipTags = tags.slice(0, 3);
const trail = items.slice(0, 3);
---

<DocPageLayout
  title={`${meta.label} | ${settings.siteName}`}
  description={meta.summary}
  settings={settings}
  navigation={navigation}
  path={meta.href}
  mainClass="max-w-[1200px] mx-auto px-6 py-12"
>
  <header class="mb-16">
    <h1 class="mb-4 font-h1 text-h1 text-on-surface">{meta.label}</h1>
    <p class="max-w-2xl font-body-lg text-body-lg text-on-surface-variant">{meta.summary}</p>
  </header>

  {lead && (
    <section class="mb-20">
      <div class="mb-8 flex items-center justify-between">
        <h2 class="font-h2 text-h2 text-on-surface">教程 / 文章总结</h2>
        <a class="flex items-center gap-1 font-medium text-primary hover:underline" href={itemHref(lead)}>
          查看全部 <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
        </a>
      </div>
      <div class="bento-grid">
        <a
          href={itemHref(lead)}
          class="group relative overflow-hidden rounded-xl border border-outline-variant/30 bg-white p-8 shadow-[0_4px_20px_rgba(0,0,0,0.04)] col-span-12 md:col-span-8"
        >
          <div class="relative z-10 max-w-[60%]">
            <span class="mb-4 inline-block rounded-full bg-primary-fixed px-3 py-1 font-label-caps text-label-caps text-on-primary-fixed">
              深度阅读
            </span>
            <h3 class="mb-4 font-h3 text-h3 text-on-surface">{lead.title}</h3>
            <p class="mb-6 text-on-surface-variant">{lead.excerpt}</p>
            <div class="flex items-center gap-4 text-sm text-outline">
              <span class="font-medium text-on-surface">{lead.category?.name || "Research Team"}</span>
              <span>•</span>
              <span>{lead.readingTime || 6} Min Read</span>
            </div>
          </div>
          <div class="absolute right-0 top-0 h-full w-1/2 opacity-10 transition-opacity group-hover:opacity-20">
            <img class="h-full w-full object-cover" src={itemImage(lead)} alt={lead.coverAlt || lead.title} />
          </div>
        </a>

        {secondary.map((item, index) => (
          <a
            href={itemHref(item)}
            class="col-span-12 rounded-xl border border-outline-variant/30 bg-white p-8 shadow-[0_4px_20px_rgba(0,0,0,0.04)] md:col-span-4"
          >
            <span class:list={[
              "mb-4 inline-block rounded-full px-3 py-1 font-label-caps text-label-caps",
              index === 0
                ? "bg-tertiary-fixed text-on-tertiary-fixed"
                : "bg-surface-container text-on-surface-variant"
            ]}>
              {index === 0 ? "快速笔记" : "论文精读"}
            </span>
            <h3 class="mb-3 text-[20px] font-h3 leading-tight text-on-surface">{item.title}</h3>
            <p class="mb-4 text-sm text-on-surface-variant">{item.excerpt}</p>
            <span class="inline-flex items-center gap-1 text-sm font-medium text-primary">
              阅读全文 <span class="material-symbols-outlined text-[14px]">open_in_new</span>
            </span>
          </a>
        ))}

        <div class="col-span-12 flex flex-col justify-center rounded-xl border border-primary/10 bg-surface-container-lowest p-8 shadow-[0_4px_20px_rgba(0,0,0,0.04)] md:col-span-8">
          <div class="flex items-start gap-6">
            <div class="rounded-xl bg-primary/5 p-4">
              <span class:list={["material-symbols-outlined text-[40px]", sectionVisuals.learn.accent]}>
                menu_book
              </span>
            </div>
            <div>
              <h3 class="mb-2 font-h3 text-h3 text-on-surface">知识库精选</h3>
              <p class="mb-4 text-on-surface-variant">
                围绕 {lead.category?.name || meta.label} 组织结构化内容，提升可索引性、可引用性与持续更新效率。
              </p>
              <div class="flex flex-wrap gap-2">
                {itemHighlights(lead).map((text) => (
                  <span class="rounded bg-surface-container-high px-3 py-1 text-xs font-medium text-on-surface-variant">
                    {text}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="mb-20">
    <div class="mb-8">
      <h2 class="font-h2 text-h2 text-on-surface">技术点滴</h2>
      <p class="text-on-surface-variant">接口、标签、分类与正文结构共同构成这个栏目页的知识脉络。</p>
    </div>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {categories.slice(0, 3).map((category, index) => (
        <a
          href={`/categories/${category.slug}`}
          class="rounded-xl border border-outline-variant/30 bg-white p-6 transition-colors hover:border-primary/30"
        >
          <div class="mb-4 flex items-center gap-3">
            <span class:list={["material-symbols-outlined", sectionVisuals.learn.accent]}>
              {index === 0 ? "terminal" : index === 1 ? "construction" : "bug_report"}
            </span>
            <span class="font-label-caps text-label-caps text-outline">
              {index === 0 ? "Coding Tip" : index === 1 ? "Toolbox" : "Debug Log"}
            </span>
          </div>
          <h4 class="mb-2 text-lg font-semibold">{category.name}</h4>
          <p class="mb-4 text-sm text-on-surface-variant">{category.description || meta.summary}</p>
          <div class="mb-4 h-[2px] w-full bg-primary-fixed">
            <div class="h-full bg-primary" style={`width: ${70 - index * 12}%`}></div>
          </div>
          <div class="flex items-center justify-between text-xs text-outline">
            <span>{tipTags[index]?.name || "Knowledge Graph"}</span>
            <span>{meta.count} entries</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="mb-20">
    <div class="mb-12 text-center">
      <h2 class="font-h2 text-h2 text-on-surface">思考路径</h2>
      <p class="text-on-surface-variant">用时间线组织持续更新的认知轨迹。</p>
    </div>
    <div class="timeline-border mx-auto ml-4 max-w-3xl space-y-12 pl-10 md:ml-auto">
      {trail.map((item, index) => (
        <a href={itemHref(item)} class="relative block">
          <div class:list={[
            "absolute -left-[45px] top-0 h-4 w-4 rounded-full border-4 border-white shadow-sm",
            index === 0 ? "bg-primary" : "bg-outline-variant"
          ]}></div>
          <div class="rounded-xl border border-outline-variant/30 bg-white p-8 shadow-sm">
            <span class:list={[
              "mb-2 block font-label-caps text-label-caps font-semibold",
              index === 0 ? "text-primary" : "text-outline"
            ]}>
              {formatDateDot(item.publishedAt || item.updatedAt)}
            </span>
            <h4 class="mb-3 text-xl font-bold">{item.title}</h4>
            <p class="text-on-surface-variant">{item.excerpt}</p>
            <div class="mt-4 flex flex-wrap gap-2 pt-4 border-t border-gray-50">
              {item.tags.slice(0, 2).map((tag) => (
                <span class="rounded bg-surface-container px-2 py-1 text-xs">#{tag.name}</span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
</DocPageLayout>
