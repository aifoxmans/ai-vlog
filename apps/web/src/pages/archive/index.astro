---
import DocPageLayout from "../../layouts/DocPageLayout.astro";
import { getArchiveItems, getNavigationData } from "../../lib/api";

const [{ navigation, settings }, archive] = await Promise.all([
  getNavigationData(),
  getArchiveItems()
]);

const totalEntries = archive.reduce((sum, entry) => sum + entry.count, 0);
const latestMonth = archive[0]?.month || "持续更新";
---

<DocPageLayout
  title={`内容归档 | ${settings.siteName}`}
  description="按时间查看站点公开内容的归档入口。"
  settings={settings}
  navigation={navigation}
  path="/archive"
  mainClass="max-w-[1200px] mx-auto px-6 py-12"
>
  <section class="mb-14 overflow-hidden rounded-xl border border-outline-variant/30 bg-white shadow-[0_4px_20px_rgba(0,0,0,0.04)]">
    <div class="relative grid gap-8 p-8 md:grid-cols-[1.35fr_0.65fr] md:p-12">
      <div class="absolute -right-16 -top-24 h-72 w-72 rounded-full bg-primary-fixed opacity-50 blur-3xl"></div>
      <div class="relative z-10">
        <span class="mb-5 inline-flex rounded-full bg-primary-fixed px-3 py-1 font-label-caps text-label-caps text-on-primary-fixed">
          Archive
        </span>
        <h1 class="mb-5 max-w-3xl font-h1 text-h1 text-on-surface">按时间归档站点内容</h1>
        <p class="max-w-2xl font-body-lg text-body-lg text-on-surface-variant">
          归档页把公开内容按月份收束，方便搜索、复盘和快速回到最近一次更新。
        </p>
      </div>

      <div class="relative z-10 grid gap-4 sm:grid-cols-2 md:grid-cols-1">
        <div class="rounded-xl bg-surface-container-lowest p-6">
          <div class="font-label-caps text-label-caps text-on-surface-variant">Total entries</div>
          <div class="mt-3 text-4xl font-bold text-primary">{totalEntries}</div>
        </div>
        <div class="rounded-xl bg-inverse-surface p-6 text-inverse-on-surface">
          <div class="font-label-caps text-label-caps opacity-70">Latest month</div>
          <div class="mt-3 text-3xl font-bold">{latestMonth}</div>
        </div>
      </div>
    </div>
  </section>

  <section class="grid gap-5">
    {archive.map((entry) => (
      <article class="group grid gap-5 rounded-xl border border-outline-variant/30 bg-white p-6 shadow-[0_4px_20px_rgba(0,0,0,0.04)] transition-all hover:-translate-y-0.5 hover:border-primary/30 md:grid-cols-[180px_1fr_120px] md:items-center">
        <div>
          <div class="font-label-caps text-label-caps text-on-surface-variant">Archive</div>
          <h2 class="mt-2 text-3xl font-bold tracking-tight text-on-surface">{entry.month}</h2>
        </div>
        <div>
          <p class="mb-2 text-sm font-semibold text-primary">本月最新内容</p>
          <h3 class="text-xl font-semibold leading-snug text-on-surface">{entry.latestTitle}</h3>
        </div>
        <div class="flex items-center justify-between rounded-xl bg-surface-container px-5 py-4 text-on-surface md:block md:text-center">
          <span class="text-3xl font-bold text-primary">{entry.count}</span>
          <span class="ml-2 text-sm text-on-surface-variant md:ml-0 md:block">篇内容</span>
        </div>
      </article>
    ))}

    {archive.length === 0 && (
      <div class="rounded-xl border border-dashed border-outline-variant bg-white p-10 text-center text-on-surface-variant">
        暂无归档内容。
      </div>
    )}
  </section>
</DocPageLayout>
