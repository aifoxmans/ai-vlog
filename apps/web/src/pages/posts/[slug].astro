---
import type {
  ContentDetail,
  ContentItem,
  NavigationItem,
  SiteSettings
} from "@ai-vlog/shared";
import DocPageLayout from "../../layouts/DocPageLayout.astro";
import {
  getContent,
  getNavigationData,
  getSectionItems,
  getSectionOverview
} from "../../lib/api";
import type { SectionOverview } from "../../lib/api";
import { formatDate, formatNumber } from "../../lib/format";
import { formatDateDot, itemHref, itemImage } from "../../lib/public-ui";

const { slug } = Astro.params;

let navigation: NavigationItem[] = [];
let settings!: SiteSettings;
let item!: ContentDetail;
let related!: { items: ContentItem[]; total: number };
let jsonLd: Array<Record<string, unknown>> = [];
let meta: SectionOverview | undefined;

try {
  const [navData, content, sectionOverview] = await Promise.all([
    getNavigationData(),
    slug ? getContent(slug) : Promise.reject(new Error("Missing slug")),
    getSectionOverview()
  ]);

  navigation = navData.navigation;
  settings = navData.settings;
  item = content;
  related = await getSectionItems(item.section === "page" ? "learn" : item.section);
  jsonLd = [
    {
      "@context": "https://schema.org",
      "@type": item.video ? "VideoObject" : "Article",
      headline: item.title,
      description: item.excerpt,
      datePublished: item.publishedAt,
      dateModified: item.updatedAt,
      image: item.coverImage ? [item.coverImage] : undefined,
      mainEntityOfPage: new URL(`/posts/${item.slug}`, settings.siteUrl).toString()
    }
  ];
  meta = sectionOverview.find(
    (entry) => entry.section === (item.section === "page" ? "learn" : item.section)
  );
} catch {
  return Astro.redirect("/");
}

const categoryLink = item.category ? `/categories/${item.category.slug}` : undefined;
const articlePath = `/posts/${item.slug}`;
---

<DocPageLayout
  title={item.seo.title}
  description={item.seo.description}
  settings={settings}
  navigation={navigation}
  path={articlePath}
  image={item.seo.ogImage || item.coverImage}
  jsonLd={jsonLd}
  mainClass="max-w-[1200px] mx-auto px-6 py-10"
>
  <section class="mx-auto max-w-[1080px]">
    <div class="mb-6 flex flex-wrap items-center gap-3 text-sm text-outline">
      {meta && (
        <a
          href={meta.href}
          class="inline-flex items-center gap-1 rounded-full bg-surface-container px-3 py-1.5 font-label-caps text-label-caps text-primary transition-colors hover:bg-primary-fixed"
        >
          <span class="material-symbols-outlined text-base">arrow_back</span>
          {meta.label}
        </a>
      )}
      <span>·</span>
      <span>{formatDate(item.publishedAt || item.updatedAt)}</span>
      {item.readingTime && (
        <>
          <span>·</span>
          <span>{item.readingTime} min read</span>
        </>
      )}
      {item.video?.platform && (
        <>
          <span>·</span>
          <span class="uppercase">{item.video.platform}</span>
        </>
      )}
    </div>

    <div class="rounded-[32px] border border-outline-variant/30 bg-white p-8 shadow-[0_4px_20px_rgba(0,0,0,0.04)] md:p-12">
      <div class="mb-6 flex flex-wrap items-center gap-3">
        <span class="rounded-full bg-primary-fixed px-3 py-1 text-label-caps text-on-primary-fixed-variant">
          {meta?.label || item.section}
        </span>
        {item.featured && (
          <span class="rounded-full bg-tertiary-fixed px-3 py-1 text-label-caps text-on-tertiary-fixed-variant">
            Featured
          </span>
        )}
      </div>

      <h1 class="max-w-4xl text-[clamp(2.4rem,5vw,4.6rem)] font-bold leading-[1.02] tracking-[-0.04em] text-on-surface">
        {item.title}
      </h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-on-surface-variant">
        {item.excerpt}
      </p>

      <div class="mt-8 flex flex-wrap gap-2">
        {item.category && (
          <a
            href={categoryLink}
            class="rounded-full bg-surface-container px-3 py-1.5 text-sm font-medium text-on-surface transition-colors hover:bg-surface-container-high"
          >
            #{item.category.name}
          </a>
        )}
        {item.tags.map((tag) => (
          <a
            href={`/tags/${tag.slug}`}
            class="rounded-full bg-surface-container px-3 py-1.5 text-sm font-medium text-on-surface-variant transition-colors hover:bg-primary-fixed"
          >
            #{tag.name}
          </a>
        ))}
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-[minmax(0,1fr)_280px]">
        <div class="overflow-hidden rounded-[24px] border border-outline-variant/30 bg-surface-container-low">
          {item.coverImage && (
            <img
              src={item.coverImage}
              alt={item.coverAlt || item.title}
              class="h-full max-h-[560px] w-full object-cover"
            />
          )}
          {!item.coverImage && item.video?.posterUrl && (
            <img
              src={item.video.posterUrl}
              alt={item.title}
              class="h-full max-h-[560px] w-full object-cover"
            />
          )}
          {!item.coverImage && !item.video?.posterUrl && (
            <img
              src={itemImage(item)}
              alt={item.title}
              class="h-full max-h-[560px] w-full object-cover"
            />
          )}
        </div>

        <aside class="flex h-full flex-col justify-between rounded-[24px] border border-outline-variant/30 bg-surface-container-low p-6">
          <div>
            <div class="mb-6">
              <div class="font-label-caps text-label-caps text-outline">文章信息</div>
            </div>
            <div class="space-y-4 text-sm">
              <div class="flex items-center justify-between gap-4 border-b border-outline-variant/40 pb-3">
                <span class="text-outline">发布时间</span>
                <strong class="text-on-surface">{formatDate(item.publishedAt || item.updatedAt)}</strong>
              </div>
              <div class="flex items-center justify-between gap-4 border-b border-outline-variant/40 pb-3">
                <span class="text-outline">阅读时长</span>
                <strong class="text-on-surface">{item.readingTime ? `${item.readingTime} 分钟` : "短读"}</strong>
              </div>
              <div class="flex items-center justify-between gap-4 border-b border-outline-variant/40 pb-3">
                <span class="text-outline">内容形态</span>
                <strong class="text-on-surface">{item.video ? "视频 / 文章" : "文章"}</strong>
              </div>
              {typeof item.metrics?.views === "number" && (
                <div class="flex items-center justify-between gap-4 pb-1">
                  <span class="text-outline">公开浏览</span>
                  <strong class="text-on-surface">{formatNumber(item.metrics.views)}</strong>
                </div>
              )}
            </div>
          </div>

          <div class="mt-8 space-y-3">
            {meta && (
              <a
                href={meta.href}
                class="flex items-center justify-between rounded-2xl border border-outline-variant/30 bg-white px-4 py-3 text-sm font-medium text-on-surface transition-transform hover:-translate-y-0.5"
              >
                <span>返回 {meta.label}</span>
                <span class="material-symbols-outlined text-base">arrow_forward</span>
              </a>
            )}
            {categoryLink && (
              <a
                href={categoryLink}
                class="flex items-center justify-between rounded-2xl border border-outline-variant/30 bg-white px-4 py-3 text-sm font-medium text-on-surface transition-transform hover:-translate-y-0.5"
              >
                <span>查看分类</span>
                <span class="material-symbols-outlined text-base">arrow_forward</span>
              </a>
            )}
          </div>
        </aside>
      </div>
    </div>
  </section>

  {item.video?.embedUrl && (
    <section class="mx-auto mt-8 max-w-[1080px]">
      <div class="overflow-hidden rounded-[32px] border border-outline-variant/30 bg-white p-4 shadow-[0_4px_20px_rgba(0,0,0,0.04)] md:p-6">
        <iframe
          src={item.video.embedUrl}
          title={item.title}
          width="100%"
          height="560"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          class="w-full rounded-[24px]"
        ></iframe>
      </div>
    </section>
  )}

  <section class="mx-auto mt-8 grid max-w-[1080px] gap-8 lg:grid-cols-[minmax(0,1fr)_280px]">
    <article class="rounded-[32px] border border-outline-variant/30 bg-white p-8 shadow-[0_4px_20px_rgba(0,0,0,0.04)] md:p-12">
      <div class="doc-prose" set:html={item.bodyHtml || item.bodyMarkdown}></div>
    </article>

    <aside class="space-y-4">
      <div class="rounded-[28px] border border-outline-variant/30 bg-white p-6 shadow-[0_4px_20px_rgba(0,0,0,0.04)]">
        <div class="mb-4 font-label-caps text-label-caps text-outline">快速索引</div>
        <div class="space-y-3">
          {item.tags.map((tag) => (
            <a
              href={`/tags/${tag.slug}`}
              class="flex items-center justify-between rounded-2xl bg-surface-container-low px-4 py-3 text-sm font-medium text-on-surface transition-colors hover:bg-primary-fixed"
            >
              <span>#{tag.name}</span>
              <span class="material-symbols-outlined text-base">north_east</span>
            </a>
          ))}
        </div>
      </div>

      <div class="rounded-[28px] border border-outline-variant/30 bg-primary p-6 text-on-primary shadow-[0_4px_20px_rgba(0,0,0,0.08)]">
        <div class="mb-3 font-label-caps text-label-caps text-on-primary-container/70">一句话摘要</div>
        <p class="text-base leading-7 text-white/90">{item.excerpt}</p>
      </div>
    </aside>
  </section>

  {related.items.filter((entry) => entry.slug !== item.slug).length > 0 && (
    <section class="mx-auto mt-12 max-w-[1080px]">
      <div class="mb-6 flex items-end justify-between gap-4">
        <div>
          <span class="font-label-caps text-label-caps text-primary">Related</span>
          <h2 class="mt-2 font-h2 text-h2 text-on-surface">同栏目相关文章</h2>
        </div>
        {meta && (
          <a href={meta.href} class="text-sm font-semibold text-primary hover:underline">
            返回栏目
          </a>
        )}
      </div>

      <div class="grid gap-5 md:grid-cols-3">
        {related.items
          .filter((entry) => entry.slug !== item.slug)
          .slice(0, 3)
          .map((entry) => (
            <a
              href={itemHref(entry)}
              class="group rounded-[28px] border border-outline-variant/30 bg-white p-5 shadow-[0_4px_20px_rgba(0,0,0,0.04)] transition-transform hover:-translate-y-1"
            >
              <div class="mb-4 overflow-hidden rounded-[20px] border border-outline-variant/20 bg-surface-container-low">
                <img
                  src={entry.coverImage || itemImage(entry)}
                  alt={entry.coverAlt || entry.title}
                  class="aspect-[16/10] w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </div>
              <div class="mb-3 flex items-center justify-between gap-3 text-[11px] uppercase tracking-[0.16em] text-outline">
                <span>{meta?.label || entry.section}</span>
                <span>{formatDateDot(entry.publishedAt || entry.updatedAt)}</span>
              </div>
              <h3 class="mb-3 text-[1.2rem] font-semibold leading-tight text-on-surface transition-colors group-hover:text-primary">
                {entry.title}
              </h3>
              <p class="mb-4 text-sm leading-7 text-on-surface-variant">{entry.excerpt}</p>
              <div class="flex flex-wrap gap-2">
                {entry.tags.slice(0, 2).map((tag) => (
                  <span class="rounded-full bg-surface-container px-3 py-1 text-xs text-on-surface-variant">
                    #{tag.name}
                  </span>
                ))}
              </div>
            </a>
          ))}
      </div>
    </section>
  )}
</DocPageLayout>
