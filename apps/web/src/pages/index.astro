---
import DocPageLayout from "../layouts/DocPageLayout.astro";
import { getHomeData, getNavigationData, getSectionOverview } from "../lib/api";
import {
  formatDateDot,
  itemHref,
  itemImage,
  metricLabel,
  sectionVisuals
} from "../lib/public-ui";

const [{ navigation, settings }, home, sections] = await Promise.all([
  getNavigationData(),
  getHomeData(),
  getSectionOverview()
]);

const latest = home.latest.slice(0, 3);
const lead = latest[0];
const follow = latest[1] || latest[0];
const learn = sections.find((item) => item.section === "learn");
const venture = sections.find((item) => item.section === "venture");
const showcase = sections.find((item) => item.section === "showcase");
const journal = sections.find((item) => item.section === "journal");
const resources = sections.find((item) => item.section === "resources");

const leadKicker = lead
  ? `${sections.find((item) => item.section === lead.section)?.label || "最新更新"} · ${formatDateDot(lead.publishedAt || lead.updatedAt)}`
  : "内容系统 · 持续更新";
---

<DocPageLayout
  title={`${settings.siteName} | 首页`}
  description={settings.siteDescription}
  settings={settings}
  navigation={navigation}
  path="/"
>
  <section class="flex flex-col items-center py-20 text-center">
    <div class="mb-6 inline-flex items-center rounded-full bg-primary-fixed px-3 py-1 text-label-caps text-on-primary-fixed-variant">
      {leadKicker}
    </div>
    <h1 class="mb-6 max-w-4xl font-h1 text-h1 text-on-surface">{settings.heroTitle}</h1>
    <p class="mb-10 max-w-2xl font-body-lg text-body-lg text-on-surface-variant">
      {settings.heroSummary}
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a
        href={lead ? itemHref(lead) : "/archive"}
        class="rounded-xl bg-primary-container px-8 py-4 font-semibold text-on-primary-container shadow-lg transition-all hover:brightness-110"
      >
        开始阅读
      </a>
      <a
        href="/archive"
        class="rounded-xl border border-outline-variant bg-surface-container-lowest px-8 py-4 font-semibold text-on-surface transition-all hover:bg-surface-container"
      >
        查看归档
      </a>
    </div>
  </section>

  <section class="mb-20">
    <div class="grid min-h-[520px] grid-cols-1 gap-6 md:grid-cols-4 md:grid-rows-2">
      {learn && (
        <a
          href={learn.href}
          class="group relative overflow-hidden rounded-xl border border-gray-100 bg-white p-8 shadow-[0_4px_20px_rgba(0,0,0,0.04)] md:col-span-2 md:row-span-2"
        >
          <div class="absolute inset-0 opacity-10 transition-transform duration-700 group-hover:scale-105">
            <img class="h-full w-full object-cover" src={itemImage(lead, learn.label)} alt={learn.label} />
          </div>
          <div class="relative z-10 flex h-full flex-col justify-end">
            <span class:list={["material-symbols-outlined mb-4 text-4xl", sectionVisuals.learn.accent]}>
              {sectionVisuals.learn.icon}
            </span>
            <h3 class="mb-2 font-h3 text-h3">{learn.label}</h3>
            <p class="mb-6 text-on-surface-variant">{learn.summary}</p>
            <span class="inline-flex items-center gap-2 font-bold text-primary">
              {sectionVisuals.learn.action}
              <span class="material-symbols-outlined">arrow_forward</span>
            </span>
          </div>
        </a>
      )}

      {venture && (
        <a
          href={venture.href}
          class="group relative overflow-hidden rounded-xl border border-gray-100 bg-white p-8 shadow-[0_4px_20px_rgba(0,0,0,0.04)] md:col-span-2"
        >
          <div class="flex h-full items-center justify-between gap-6">
            <div class="max-w-[60%]">
              <span class:list={["material-symbols-outlined mb-2 text-3xl", sectionVisuals.venture.accent]}>
                {sectionVisuals.venture.icon}
              </span>
              <h3 class="mb-1 font-h3 text-h3">{venture.label}</h3>
              <p class="text-sm text-on-surface-variant">{venture.summary}</p>
            </div>
            <div class="flex h-32 w-32 items-center justify-center rounded-lg bg-tertiary-fixed">
              <div class="text-center">
                <div class="text-4xl font-bold text-on-tertiary-fixed">{venture.count}</div>
                <div class="mt-1 text-[10px] uppercase tracking-[0.2em] text-on-tertiary-fixed-variant">
                  Entries
                </div>
              </div>
            </div>
          </div>
        </a>
      )}

      {showcase && (
        <a
          href={showcase.href}
          class="group relative flex flex-col overflow-hidden rounded-xl border border-gray-100 bg-white p-6 shadow-[0_4px_20px_rgba(0,0,0,0.04)]"
        >
          <span class:list={["material-symbols-outlined mb-4 text-3xl", sectionVisuals.showcase.accent]}>
            {sectionVisuals.showcase.icon}
          </span>
          <h3 class="mb-1 font-h3 text-lg">{showcase.label}</h3>
          <p class="mb-4 text-xs text-on-surface-variant">{showcase.summary}</p>
          <div class="mt-auto flex items-center justify-between text-xs text-on-surface-variant">
            <span>{showcase.count} 个公开条目</span>
            <span class="material-symbols-outlined text-base">arrow_forward</span>
          </div>
        </a>
      )}

      {journal && (
        <a
          href={journal.href}
          class="group relative flex flex-col overflow-hidden rounded-xl border border-gray-100 bg-white p-6 shadow-[0_4px_20px_rgba(0,0,0,0.04)]"
        >
          <span class:list={["material-symbols-outlined mb-4 text-3xl", sectionVisuals.journal.accent]}>
            {sectionVisuals.journal.icon}
          </span>
          <h3 class="mb-1 font-h3 text-lg">{journal.label}</h3>
          <p class="mb-4 text-xs text-on-surface-variant">{journal.summary}</p>
          <div class="mt-auto">
            <span class="text-xs font-medium text-on-surface-variant">{journal.count} 篇日志沉淀</span>
          </div>
        </a>
      )}
    </div>
  </section>

  <section class="mb-20 grid grid-cols-1 gap-12 md:grid-cols-12">
    <div class="md:col-span-8">
      <div class="mb-8 flex items-center justify-between">
        <div>
          <h2 class="font-h2 text-h2">最新动态</h2>
        </div>
        <div class="flex gap-2">
          <span class="rounded-full bg-surface-container px-4 py-2 text-sm font-semibold text-primary">
            全部
          </span>
          <span class="rounded-full px-4 py-2 text-sm font-medium text-on-surface-variant">
            文章 / 视频
          </span>
        </div>
      </div>

      <div class="space-y-12">
        {latest.slice(0, 2).map((item, index) => {
          const meta = sections.find((entry) => entry.section === item.section);
          return (
            <div class="group flex gap-8">
              <div class="flex flex-col items-center">
                <div class:list={[
                  "mt-2 h-3 w-3 rounded-full",
                  index === 0 ? "bg-primary" : "bg-outline-variant"
                ]}></div>
                <div class="mt-2 h-full w-0.5 bg-outline-variant"></div>
              </div>
              <a
                href={itemHref(item)}
                class="flex-1 rounded-xl border border-gray-100 bg-white p-8 shadow-[0_4px_20px_rgba(0,0,0,0.04)] transition-all hover:border-primary-container"
              >
                <div class="mb-4 flex items-start justify-between">
                  <span class="text-xs font-bold uppercase tracking-widest text-primary">
                    {meta?.label || item.section}
                  </span>
                  <span class="text-sm text-on-surface-variant">
                    {formatDateDot(item.publishedAt || item.updatedAt)}
                  </span>
                </div>
                <h3 class="mb-3 font-h3 text-h3 transition-colors group-hover:text-primary">
                  {item.title}
                </h3>
                <p class="mb-6 text-on-surface-variant">{item.excerpt}</p>
                <div class="relative mb-6 h-64 overflow-hidden rounded-lg">
                  <img class="h-full w-full object-cover" src={itemImage(item)} alt={item.coverAlt || item.title} />
                </div>
                <div class="flex items-center gap-4 text-xs text-on-surface-variant">
                  <span class="inline-flex items-center gap-1">
                    <span class="material-symbols-outlined text-base">visibility</span>
                    {metricLabel(item)}
                  </span>
                  {item.metrics?.likes && (
                    <span class="inline-flex items-center gap-1">
                      <span class="material-symbols-outlined text-base">favorite</span>
                      {item.metrics.likes}
                    </span>
                  )}
                </div>
              </a>
            </div>
          );
        })}
      </div>
    </div>

    <div class="space-y-8 md:col-span-4">
      {lead && (
        <div class="rounded-xl border border-gray-100 bg-white p-8 shadow-[0_4px_20px_rgba(0,0,0,0.04)]">
          <h4 class="mb-6 font-label-caps text-label-caps text-on-surface-variant">当前状态</h4>
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-sm font-medium">主打内容</span>
              <span class="rounded bg-primary-fixed px-2 py-1 text-[10px] font-bold uppercase text-on-primary-fixed">
                {sections.find((item) => item.section === lead.section)?.label || lead.section}
              </span>
            </div>
            <div class="h-1.5 w-full rounded-full bg-surface-container">
              <div class="h-1.5 rounded-full bg-primary" style="width: 78%"></div>
            </div>
            <div class="flex justify-between text-[10px] text-on-surface-variant">
              <span>最近更新</span>
              <span>{formatDateDot(lead.updatedAt || lead.publishedAt)}</span>
            </div>
          </div>
          <hr class="my-6 border-gray-100" />
          <a href={itemHref(lead)} class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary-container text-on-primary-container">
              <span class="material-symbols-outlined">bolt</span>
            </div>
            <div>
              <div class="text-xs text-on-surface-variant">继续阅读</div>
              <div class="text-sm font-bold">{lead.title}</div>
            </div>
          </a>
        </div>
      )}

      <div class="rounded-xl bg-inverse-surface p-8 text-inverse-on-surface shadow-lg">
        <h4 class="mb-2 text-lg font-h3">{settings.newsletterTitle}</h4>
        <p class="mb-6 text-sm opacity-80">{settings.newsletterSummary}</p>
        <div class="space-y-3">
          <input
            class="w-full rounded-lg border border-white/20 bg-white/10 px-4 py-3 text-sm focus:ring-2 focus:ring-primary"
            placeholder="你的邮箱地址"
            type="email"
          />
          <button class="w-full rounded-lg bg-primary-fixed py-3 font-bold text-on-primary-fixed">
            立即订阅
          </button>
        </div>
      </div>

      <div class="rounded-xl border border-gray-100 bg-white p-8 shadow-[0_4px_20px_rgba(0,0,0,0.04)]">
        <h4 class="mb-6 font-label-caps text-label-caps text-on-surface-variant">热门标签</h4>
        <div class="flex flex-wrap gap-2">
          {home.tags.slice(0, 6).map((tag) => (
            <a
              href={`/tags/${tag.slug}`}
              class="cursor-pointer rounded-full bg-surface-container px-3 py-1 text-xs font-medium text-on-surface-variant transition-colors hover:bg-primary-fixed"
            >
              #{tag.name}
            </a>
          ))}
        </div>
      </div>

      {resources && (
        <a
          href={resources.href}
          class="block rounded-xl border border-primary/10 bg-white p-8 shadow-[0_4px_20px_rgba(0,0,0,0.04)] transition-transform hover:-translate-y-1"
        >
          <div class="mb-4 flex items-center gap-3">
            <span class:list={["material-symbols-outlined text-3xl", sectionVisuals.resources.accent]}>
              {sectionVisuals.resources.icon}
            </span>
            <div>
              <div class="font-h3 text-lg">{resources.label}</div>
              <div class="text-xs text-on-surface-variant">{resources.count} 条可公开资源</div>
            </div>
          </div>
          <p class="text-sm text-on-surface-variant">{resources.summary}</p>
        </a>
      )}
    </div>
  </section>

  {follow && (
    <a
      href={itemHref(follow)}
      class="group fixed bottom-8 right-8 z-40 flex h-14 items-center justify-center rounded-full bg-primary px-5 text-on-primary shadow-2xl transition-all hover:scale-105 active:scale-95"
    >
      <span class="material-symbols-outlined">edit</span>
      <span class="ml-2 hidden whitespace-nowrap text-sm font-semibold sm:inline">阅读下一篇</span>
    </a>
  )}
</DocPageLayout>
