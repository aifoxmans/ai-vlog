---
import DocPageLayout from "../../layouts/DocPageLayout.astro";
import { getSectionPageData } from "../../lib/api";
import {
  formatDateDot,
  itemHref,
  itemImage,
  itemHighlights
} from "../../lib/public-ui";

const { navigation, settings, meta, items, categories, tags } = await getSectionPageData("venture");
const lead = items[0];
const highlights = itemHighlights(lead);
---

<DocPageLayout
  title={`${meta.label} | ${settings.siteName}`}
  description={meta.summary}
  settings={settings}
  navigation={navigation}
  path={meta.href}
  mainClass="max-w-[1200px] mx-auto px-6 py-16"
>
  <section class="mb-20">
    <div class="mb-12 flex flex-col items-end justify-between gap-8 md:flex-row">
      <div class="max-w-2xl">
        <span class="mb-4 block font-label-caps tracking-widest text-primary">PERSONAL ENTERPRISE ARCHIVE</span>
        <h1 class="mb-6 font-h1 text-on-surface">{meta.label}</h1>
        <p class="font-body-lg leading-relaxed text-outline">{meta.summary}</p>
      </div>
      <div class="flex gap-4">
        <div class="glass-card flex flex-col items-center rounded-xl px-6 py-4">
          <span class="mb-1 font-label-caps text-outline">公开条目</span>
          <span class="font-h3 text-primary">{meta.count}</span>
        </div>
        <div class="glass-card flex flex-col items-center rounded-xl px-6 py-4">
          <span class="mb-1 font-label-caps text-outline">核心标签</span>
          <span class="font-h3 text-primary">{tags.length}</span>
        </div>
      </div>
    </div>

    {lead && (
      <a href={itemHref(lead)} class="relative block h-[400px] overflow-hidden rounded-2xl shadow-lg">
        <img class="h-full w-full object-cover" src={itemImage(lead)} alt={lead.coverAlt || lead.title} />
        <div class="absolute inset-0 bg-gradient-to-t from-on-surface/50 to-transparent"></div>
        <div class="absolute bottom-8 left-8 text-white">
          <p class="mb-2 font-label-caps opacity-80">CURRENT FOCUS</p>
          <h2 class="font-h3">{lead.title}</h2>
        </div>
      </a>
    )}
  </section>

  <section class="mb-20">
    <div class="mb-10 flex items-center gap-4">
      <span class="material-symbols-outlined text-3xl text-primary">analytics</span>
      <h2 class="font-h2 text-on-surface">{meta.label}</h2>
    </div>
    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <div class="glass-card flex h-full flex-col rounded-xl border-l-4 border-l-primary p-8 shadow-sm">
        <span class="mb-4 font-label-caps text-outline">{lead ? `${formatDateDot(lead.publishedAt || lead.updatedAt)} • 最新发布` : "最新发布"}</span>
        <h3 class="mb-4 font-h3 text-on-surface">{lead?.title || meta.label}</h3>
        <p class="mb-6 flex-grow font-body-md text-outline">{lead?.excerpt || meta.summary}</p>
        <div class="flex items-center gap-2 text-primary">
          <span class="material-symbols-outlined text-sm">check_circle</span>
          <span class="text-sm font-semibold">{highlights[0] || "已形成稳定发布节奏"}</span>
        </div>
      </div>

      <div class="glass-card flex h-full flex-col rounded-xl border-l-4 border-l-outline-variant p-8 shadow-sm">
        <span class="mb-4 font-label-caps text-outline">分类聚焦</span>
        <h3 class="mb-4 font-h3 text-on-surface">{categories[0]?.name || "增长运营"}</h3>
        <p class="mb-6 flex-grow font-body-md text-outline">
          {categories[0]?.description || "通过结构化栏目与稳定更新，持续积累业务判断与增长复盘。"}
        </p>
        <div class="mb-2 h-1.5 w-full rounded-full bg-surface-container">
          <div class="h-1.5 rounded-full bg-primary" style="width: 65%"></div>
        </div>
        <span class="text-sm font-semibold text-outline">{meta.count} 条公开内容持续沉淀</span>
      </div>

      <div class="flex h-full flex-col rounded-xl bg-primary p-8 text-on-primary shadow-lg">
        <span class="mb-4 font-label-caps text-on-primary-container/70">决策反思</span>
        <h3 class="mb-4 font-h3 text-white">把站点当作增长装置，而不是展示册</h3>
        <p class="mb-6 flex-grow font-body-md text-white/90">
          首页负责理解，栏目页负责筛选，详情页负责信任建立与行动转化。这是当前整套系统的核心取舍。
        </p>
        {lead && (
          <a href={itemHref(lead)} class="group flex items-center gap-2 text-sm font-bold">
            阅读完整记录
            <span class="material-symbols-outlined transition-transform group-hover:translate-x-1">
              arrow_forward
            </span>
          </a>
        )}
      </div>
    </div>
  </section>

  <section class="mb-20">
    <div class="mb-10 flex items-center gap-4">
      <span class="material-symbols-outlined text-3xl text-primary">insights</span>
      <h2 class="font-h2 text-on-surface">运营与营销</h2>
    </div>
    <div class="bento-grid">
      <div class="glass-card rounded-xl p-8 shadow-sm col-span-12 md:col-span-8">
        <div class="flex flex-col gap-8 md:flex-row md:justify-between">
          <div class="flex-1">
            <h3 class="mb-6 font-h3">内容驱动增长策略</h3>
            <div class="space-y-6">
              {highlights.map((highlight, index) => (
                <div class="flex gap-4">
                  <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded bg-primary-fixed">
                    <span class="material-symbols-outlined text-primary">
                      {index === 0 ? "auto_graph" : index === 1 ? "hub" : "campaign"}
                    </span>
                  </div>
                  <div>
                    <p class="font-semibold text-on-surface">{highlight}</p>
                    <p class="text-sm text-outline">
                      {index === 0
                        ? "围绕核心主题稳定发布，形成高质量入口页。"
                        : index === 1
                          ? "通过标签与分类建立内部语义链接。"
                          : "让每篇内容都承担明确的转化或引导职责。"}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          </div>
          <div class="w-full md:w-64">
            <div class="flex aspect-square flex-col items-center justify-center rounded-xl border border-outline-variant/30 bg-surface-container p-6 text-center">
              <span class="mb-2 font-label-caps text-outline">MARKET REACH</span>
              <span class="mb-1 text-4xl font-bold text-primary">{meta.count * 3 + 9}k</span>
              <span class="text-xs text-secondary">Content Signals</span>
              <div class="mt-4 flex gap-1">
                <div class="h-8 w-2 rounded-full bg-primary"></div>
                <div class="h-10 w-2 rounded-full bg-primary"></div>
                <div class="h-6 w-2 rounded-full bg-primary"></div>
                <div class="h-12 w-2 rounded-full bg-primary"></div>
                <div class="h-8 w-2 rounded-full bg-primary"></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="glass-card col-span-12 flex flex-col rounded-xl p-8 shadow-sm md:col-span-4">
        <h3 class="mb-6 font-h3">市场反馈</h3>
        <div class="flex-grow space-y-4">
          {tags.slice(0, 2).map((tag, index) => (
            <div class="rounded-lg border border-gray-100 bg-surface p-4 text-sm italic text-outline">
              “{index === 0
                ? `关于 #${tag.name} 的内容最容易形成长期搜索入口。`
                : `#${tag.name} 更适合在栏目页和详情页里承担转化线索。`}”
              <span class="mt-2 block font-bold not-italic text-on-surface">
                — 系统观测笔记
              </span>
            </div>
          ))}
        </div>
        <div class="mt-6 flex items-center justify-between border-t border-gray-100 pt-6">
          <span class="text-sm font-semibold">Quality Score: 78</span>
          <div class="flex gap-1 text-primary">
            <span class="material-symbols-outlined text-xs">star</span>
            <span class="material-symbols-outlined text-xs">star</span>
            <span class="material-symbols-outlined text-xs">star</span>
            <span class="material-symbols-outlined text-xs">star</span>
            <span class="material-symbols-outlined text-xs">star</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</DocPageLayout>
