---
import "../styles/global.css";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Northstar Console | Login</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600;700&family=Syne:wght@500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="admin-body">
    <section class="login-shell">
      <span class="admin-kicker">Single admin access</span>
      <h1>登录后台控制台</h1>
      <p>默认 mock 环境账户为 <code>admin / admin123</code>。生产环境请通过 Workers 变量覆盖。</p>
      <form id="login-form">
        <div class="field">
          <label class="field-label" for="username">用户名</label>
          <input id="username" name="username" value="admin" autocomplete="username" required />
        </div>
        <div class="field">
          <label class="field-label" for="password">密码</label>
          <input
            id="password"
            type="password"
            name="password"
            value="admin123"
            autocomplete="current-password"
            required
          />
        </div>
        <button class="primary-button" type="submit">登录</button>
        <p id="login-status" class="status-line"></p>
      </form>
    </section>

    <script>
      import { apiRequest, tokenKey } from "../lib/api.ts";

      const form = document.getElementById("login-form") as HTMLFormElement | null;
      const status = document.getElementById("login-status") as HTMLParagraphElement | null;

      form?.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!form) return;
        const formData = new FormData(form);

        try {
          const data = await apiRequest("/api/admin/auth/login", {
            method: "POST",
            body: JSON.stringify({
              username: formData.get("username"),
              password: formData.get("password")
            })
          });

          localStorage.setItem(tokenKey, data.token);
          window.location.href = "/dashboard";
        } catch (error) {
          if (status) {
            status.textContent = error instanceof Error ? error.message : "登录失败";
          }
        }
      });
    </script>
  </body>
</html>
